caption: Pinboard (infinite canvas & presentation)
title: $:/plugins/lasjoh-toho/pinboard/templates/pinboard
tags: $:/tags/flibbles/graph/Template
list-after: $:/plugins/flibbles/graph/templates/live-graph

\whitespace trim

<$let
	pbDiveState=<<qualify "$:/state/pinboard/dive">>
	pbChain={{{ [<pbDiveState>get[list]] }}}
	pbBoard={{{ [enlist<pbChain>last[]] ~[<currentTiddler>] }}} >

<%if [enlist<pbChain>first[]match<currentTiddler>] :and[enlist<pbChain>count[]compare:number:gt[1]] %>

<div class="pb-dive-crumbs">
<$list filter="[enlist<pbChain>]" counter="pbIndex" variable="pbCrumb">
<%if [<pbIndex-first>!match[yes]] %><span class="pb-dive-sep">›</span><%endif%>
<%if [<pbIndex-last>match[yes]] %>
<span class="pb-dive-here"><$text text={{{ [<pbCrumb>removeprefix[$:/graph/]split[/]last[]] ~[<pbCrumb>] }}}/></span>
<%else%>
<$button class="tc-btn-invisible pb-dive-up" tooltip={{{ [[Back to ]addsuffix<pbCrumb>] }}}>
<$action-listops $tiddler=<<pbDiveState>> $field="list" $filter="[enlist<pbChain>first<pbIndex>]"/>
<$text text={{{ [<pbCrumb>removeprefix[$:/graph/]split[/]last[]] ~[<pbCrumb>] }}}/>
</$button>
<%endif%>
</$list>
</div>

<%endif%>

<$tiddler tiddler={{{ [enlist<pbChain>first[]match<currentTiddler>then<pbBoard>] ~[<currentTiddler>] }}} >

<$graph $engine="Pinboard" store=<<currentTiddler>> diveState=<<pbDiveState>> >

<%if [{!!filter}is[blank]] %>

<$node $tiddler="$:/plugins/flibbles/graph/settings"
  label="Click on me to configure this graph"
  image="$:/core/images/options-button"
  actions="\import $:/plugins/flibbles/graph/ui/Buttons/settings
<<settingsActions>>" />

<%endif%>

<$properties.persistent $dataTiddler=<<currentTiddler>> >

<$properties.settings>

<$slot $name=ts-raw $depth=6 />

<$nodes.writable $field=filter>

<$node.default/>

<$edges.typed $editable=yes />

</$nodes.writable>
</$properties.settings>
</$properties.persistent>
</$graph>
</$tiddler>
</$let>
