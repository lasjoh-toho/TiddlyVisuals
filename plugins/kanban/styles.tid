title: $:/plugins/lasjoh-toho/kanban/styles.css
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\rules only macrocallinline

.graph-canvas.graph-engine-kanban {
	height: 640px;
	overflow: hidden;
}

.boundingbox > .graph-canvas.graph-engine-kanban {
	height: 0%;
}

.kb-root {
	--kb-fg: <<colour foreground>>;
	--kb-muted: <<colour muted-foreground>>;
	--kb-bg: <<colour graph-background>>;
	--kb-card-bg: <<colour tiddler-background>>;
	--kb-border: <<colour tiddler-border>>;
	--kb-accent: <<colour primary>>;
	--kb-cell-bg: color-mix(in srgb, var(--kb-fg) 4%, var(--kb-bg));
	--kb-header-bg: color-mix(in srgb, var(--kb-fg) 8%, var(--kb-bg));
	position: absolute;
	inset: 0;
	overflow: hidden;
	outline: none;
	color: var(--kb-fg);
	background: var(--kb-bg);
	font-size: 14px;
}

.kb-scroll {
	position: absolute;
	inset: 0;
	overflow: auto;
}

.kb-board {
	position: relative;
	display: inline-block;
	min-width: 100%;
	padding: 12px;
	box-sizing: border-box;
}

.kb-grid {
	display: grid;
	gap: 8px;
	align-items: stretch;
}

.kb-edges {
	position: absolute;
	left: 0;
	top: 0;
	pointer-events: none;
	overflow: visible;
	z-index: 2;
}

.kb-edge-line {
	fill: none;
	stroke: var(--kb-muted);
	opacity: 0.85;
}

.kb-edge-head {
	fill: var(--kb-muted);
}

.kb-edge-label {
	font-size: 12px;
	fill: var(--kb-fg);
	paint-order: stroke;
	stroke: var(--kb-bg);
	stroke-width: 4px;
}

/* Headers */

.kb-header, .kb-corner {
	position: sticky;
	top: 0;
	z-index: 3;
	background: var(--kb-header-bg);
	border-radius: 6px;
}

.kb-header {
	display: flex;
	align-items: center;
	gap: 6px;
	padding: 6px 8px;
	font-weight: 600;
	min-height: 22px;
}

.kb-corner {
	left: 0;
	z-index: 4;
	background: var(--kb-bg);
}

.kb-lane-header {
	position: sticky;
	left: 0;
	top: auto;
	z-index: 3;
	align-items: flex-start;
	writing-mode: horizontal-tb;
	max-width: 180px;
}

.kb-header.kb-none .kb-header-label {
	font-style: italic;
	font-weight: normal;
	color: var(--kb-muted);
}

.kb-header-label {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.kb-lane-header .kb-header-label {
	white-space: normal;
}

.kb-header-count {
	font-weight: normal;
	font-size: 12px;
	color: var(--kb-muted);
	background: var(--kb-cell-bg);
	border-radius: 10px;
	padding: 0 7px;
}

.kb-header-tools {
	margin-left: auto;
	display: flex;
	gap: 1px;
	opacity: 0;
	transition: opacity 0.15s;
}

.kb-header:hover .kb-header-tools,
.kb-header:focus-within .kb-header-tools {
	opacity: 1;
}

.kb-tool, .kb-card-remove {
	border: none;
	background: transparent;
	color: var(--kb-muted);
	cursor: pointer;
	padding: 0 4px;
	font-size: 14px;
	line-height: 20px;
	border-radius: 4px;
}

.kb-tool:hover, .kb-card-remove:hover {
	color: var(--kb-fg);
	background: var(--kb-cell-bg);
}

.kb-adder {
	border: 1px dashed var(--kb-border);
	background: transparent;
	color: var(--kb-muted);
	border-radius: 6px;
	padding: 6px 8px;
	text-align: left;
	cursor: pointer;
	position: sticky;
	top: 0;
	z-index: 3;
}

.kb-lane-adder {
	position: sticky;
	left: 0;
	top: auto;
	max-width: 180px;
}

.kb-adder:hover {
	color: var(--kb-fg);
	border-color: var(--kb-accent);
}

.kb-editor {
	position: sticky;
	top: 0;
	z-index: 3;
}

.kb-lane-editor {
	left: 0;
	top: auto;
}

.kb-input {
	width: 100%;
	box-sizing: border-box;
	padding: 5px 7px;
	border: 1px solid var(--kb-accent);
	border-radius: 6px;
	font: inherit;
	color: var(--kb-fg);
	background: var(--kb-card-bg);
}

/* Cells and cards */

.kb-cell {
	position: relative;
	display: flex;
	flex-direction: column;
	gap: 8px;
	padding: 8px;
	min-height: 60px;
	background: var(--kb-cell-bg);
	border-radius: 6px;
}

.kb-filler {
	min-height: 0;
}

.kb-card {
	position: relative;
	background: var(--kb-card-bg);
	border: 1px solid var(--kb-border);
	border-left: 4px solid var(--kb-card-color, var(--kb-border));
	border-radius: 6px;
	padding: 6px 8px;
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
	cursor: grab;
	touch-action: none;
	-webkit-user-select: none;
	user-select: none;
	overflow: hidden;
	overflow-wrap: anywhere;
}

.kb-readonly .kb-card {
	cursor: pointer;
	touch-action: auto;
}

.kb-card:focus-visible {
	outline: 2px solid var(--kb-accent);
	outline-offset: 1px;
}

.kb-card.kb-hidden {
	display: none;
}

.kb-card-title {
	font-weight: 600;
	padding-right: 16px;
}

.kb-card-body {
	font-size: 13px;
	-webkit-user-select: text;
	user-select: text;
}

.kb-card-title + .kb-card-body {
	margin-top: 4px;
}

.kb-card-body > p:first-child, .kb-field p:first-child {
	margin-top: 0;
}

.kb-card-body p:last-child {
	margin-bottom: 0;
}

.kb-card-body img {
	max-width: 100%;
	height: auto;
}

.kb-field + .kb-field {
	margin-top: 3px;
}

.kb-field-name {
	color: var(--kb-muted);
	margin-right: 6px;
}

.kb-card-remove {
	position: absolute;
	top: 2px;
	right: 2px;
	opacity: 0;
}

.kb-card:hover .kb-card-remove {
	opacity: 1;
}

.kb-add-card {
	border: none;
	background: transparent;
	color: var(--kb-muted);
	font-size: 16px;
	border-radius: 6px;
	padding: 2px;
	cursor: pointer;
	opacity: 0;
	transition: opacity 0.15s;
	margin-top: auto;
}

.kb-cell:hover .kb-add-card, .kb-add-card:focus-visible {
	opacity: 1;
}

.kb-add-card:hover {
	background: var(--kb-header-bg);
	color: var(--kb-fg);
}

.kb-placeholder {
	border: 2px dashed var(--kb-accent);
	border-radius: 6px;
	box-sizing: border-box;
	opacity: 0.6;
}

.kb-ghost {
	position: fixed;
	left: 0;
	top: 0;
	z-index: 10000;
	pointer-events: none;
	box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
	cursor: grabbing;
	background: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	border-color: <<colour tiddler-border>>;
	font-size: 14px;
}

.kb-is-dragging, .kb-is-dragging * {
	cursor: grabbing !important;
}

.kb-is-dragging .kb-add-card {
	opacity: 0;
}

.kb-card.kb-flash {
	animation: kb-flash 1.2s ease-out;
}

@keyframes kb-flash {
	0% { box-shadow: 0 0 0 4px var(--kb-accent); }
	100% { box-shadow: 0 0 0 0 transparent; }
}
