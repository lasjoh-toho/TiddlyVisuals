title: $:/plugins/lasjoh-toho/kanban/styles.css
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\rules only macrocallinline

.graph-canvas.graph-engine-kanban {
	height: 640px;
	overflow: hidden;
	/* The board draws its own background and border below the toolbar,
	   so the toolbar strip shows whatever is behind the canvas. */
	background: transparent;
	border: none;
}

.boundingbox > .graph-canvas.graph-engine-kanban {
	height: 0%;
}

.kb-root {
	--kb-fg: <<colour foreground>>;
	--kb-muted: <<colour muted-foreground>>;
	--kb-bg: <<colour graph-background>>;
	--kb-card-bg: <<colour tiddler-background>>;
	--kb-border: <<colour tiddler-border>>;
	--kb-accent: <<colour primary>>;
	--kb-cell-bg: color-mix(in srgb, var(--kb-fg) 4%, var(--kb-bg));
	--kb-header-bg: color-mix(in srgb, var(--kb-fg) 8%, var(--kb-bg));
	position: absolute;
	inset: 0;
	overflow: hidden;
	outline: none;
	color: var(--kb-fg);
	background: transparent;
	font-size: 14px;
}

.kb-scroll {
	position: absolute;
	inset: 34px 0 0 0;
	overflow: auto;
	background: var(--kb-bg);
	border: 1px solid <<colour graph-border>>;
}

/*** Toolbar: a thin transparent strip above the board ***/

.kb-toolbar {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 34px;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 3px 8px 0 12px;
	background: transparent;
	z-index: 6;
}

.kb-search-wrap {
	flex: 0 1 240px;
	min-width: 130px;
	display: flex;
	align-items: center;
	height: 28px;
	box-sizing: border-box;
	border: 1px solid transparent;
	border-radius: 14px;
	background: color-mix(in srgb, var(--kb-fg) 6%, transparent);
	color: var(--kb-muted);
	transition: background .15s, border-color .15s;
}
.kb-search-wrap:focus-within, .kb-search-wrap.kb-searching {
	background: var(--kb-card-bg);
	border-color: var(--kb-border);
}
.kb-search-wrap.kb-searching { border-color: var(--kb-accent); }
.kb-search-lens { display: inline-flex; padding: 0 4px 0 9px; flex: none; }

.kb-search {
	flex: 1;
	min-width: 0;
	height: 100%;
	box-sizing: border-box;
	padding: 0 4px;
	border: none;
	outline: none;
	background: transparent;
	color: var(--kb-fg);
	font: inherit;
	font-size: 13px;
}

.kb-saved-toggle {
	flex: none;
	height: 100%;
	padding: 0 9px 0 6px;
	border: none;
	border-left: 1px solid color-mix(in srgb, var(--kb-fg) 12%, transparent);
	border-radius: 0 14px 14px 0;
	background: transparent;
	color: var(--kb-muted);
	cursor: pointer;
	font-size: 12px;
}
.kb-saved-toggle:hover { color: var(--kb-fg); }

.kb-filter-badge {
	max-width: 260px;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	padding: 1px 8px;
	border: 1px dashed var(--kb-border);
	border-radius: 10px;
	background: transparent;
	color: var(--kb-muted);
	font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	font-size: 11px;
	cursor: pointer;
}

.kb-toolbar-end { display: flex; gap: 2px; margin-left: auto; }

.kb-iconbtn {
	width: 28px;
	height: 28px;
	border: none;
	border-radius: 8px;
	background: transparent;
	color: var(--kb-muted);
	font-size: 16px;
	line-height: 1;
	cursor: pointer;
}
.kb-iconbtn:hover { color: var(--kb-fg); }
.kb-iconbtn:hover { background: var(--kb-header-bg); }
.kb-iconbtn.kb-on { background: var(--kb-accent); color: <<colour background>>; }

/* Fullscreen: the page is fullscreen, the board covers it below
   TiddlyWiki's dialogs. */
.kb-root.kb-fullscreen {
	position: fixed;
	inset: 0;
	z-index: 850;
	width: 100vw;
	height: 100vh;
	background: <<colour background>>;
}
html:has(.kb-root.kb-fullscreen) .tc-topbar { display: none; }

/*** Popovers ***/

.kb-popover {
	position: absolute;
	z-index: 20;
	width: 300px;
	max-height: calc(100% - 16px);
	overflow-y: auto;
	box-sizing: border-box;
	padding: 12px;
	background: var(--kb-card-bg);
	border: 1px solid var(--kb-border);
	border-radius: 12px;
	box-shadow: 0 10px 30px rgba(0,0,0,.18);
}
.kb-popover-board { width: 420px; max-width: calc(100% - 16px); }
.kb-popover-saved { width: 240px; padding: 6px; }
.kb-saved-list { display: flex; flex-direction: column; }
.kb-saved-row { display: flex; align-items: center; border-radius: 6px; }
.kb-saved-row:hover { background: var(--kb-cell-bg); }
.kb-saved-item {
	flex: 1;
	min-width: 0;
	padding: 6px 8px;
	border: none;
	background: transparent;
	color: var(--kb-fg);
	font: inherit;
	font-size: 13px;
	text-align: left;
	cursor: pointer;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.kb-saved-item.kb-on { font-weight: 600; color: var(--kb-accent); }
.kb-saved-remove {
	flex: none;
	width: 26px;
	height: 26px;
	border: none;
	border-radius: 6px;
	background: transparent;
	color: var(--kb-muted);
	font-size: 16px;
	cursor: pointer;
}
.kb-saved-remove:hover { color: <<colour alert-highlight>>; background: var(--kb-header-bg); }
.kb-saved-add {
	width: 100%;
	margin-top: 4px;
	padding: 6px 8px;
	border: none;
	border-top: 1px solid var(--kb-border);
	background: transparent;
	color: var(--kb-accent);
	font: inherit;
	font-size: 13px;
	text-align: left;
	cursor: pointer;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.kb-saved-add:disabled { color: var(--kb-muted); cursor: default; }
.kb-form-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.kb-field-table { display: flex; flex-direction: column; gap: 4px; }
.kb-field-row {
	display: grid;
	grid-template-columns: minmax(70px, 1fr) 2fr 38px 44px 24px;
	align-items: center;
	gap: 6px;
	font-size: 13px;
}
.kb-field-row input[type=checkbox] { justify-self: center; margin: 0; }
.kb-field-head { font-size: 11px; font-weight: 600; color: var(--kb-muted); }
.kb-field-head span:nth-child(3), .kb-field-head span:nth-child(4) { text-align: center; }
.kb-fdef-name { font-weight: 600; overflow-wrap: anywhere; }
.kb-field-builtin .kb-fdef-name { font-weight: normal; color: var(--kb-muted); }
.kb-input.kb-input-small { padding: 3px 6px; font-size: 13px; border-color: var(--kb-border); }
.kb-input.kb-input-small:focus { border-color: var(--kb-accent); }
.kb-input:disabled { opacity: .55; }
.kb-field-add { display: flex; gap: 6px; margin-top: 4px; }
.kb-field-add input { flex: 1; min-width: 0; }
.kb-field-add .kb-textbtn { flex: none; white-space: nowrap; }
.kb-form { display: flex; flex-direction: column; gap: 10px; }
.kb-form-field { display: flex; flex-direction: column; gap: 4px; }
.kb-form-label { font-size: 12px; font-weight: 600; color: var(--kb-muted); }
.kb-form-hint { font-size: 11px; color: var(--kb-muted); line-height: 1.35; }
.kb-form-foot { display: flex; justify-content: flex-end; }
.kb-range { display: flex; align-items: center; gap: 8px; }
.kb-range input { flex: 1; }
.kb-range-value { font-size: 12px; min-width: 52px; text-align: right; font-variant-numeric: tabular-nums; }
.kb-swatches, .kb-icons { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.kb-swatch {
	width: 22px;
	height: 22px;
	border-radius: 50%;
	border: 2px solid var(--kb-card-bg);
	box-shadow: 0 0 0 1px var(--kb-border);
	background: var(--kb-swatch);
	cursor: pointer;
	padding: 0;
}
.kb-swatch.kb-on { box-shadow: 0 0 0 2px var(--kb-accent); }
.kb-color { width: 26px; height: 26px; padding: 0; border: none; background: none; cursor: pointer; }
.kb-icon-choice {
	width: 30px;
	height: 30px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 0;
	border: 1px solid var(--kb-border);
	border-radius: 6px;
	background: var(--kb-card-bg);
	color: var(--kb-fg);
	fill: var(--kb-fg);
	cursor: pointer;
}
.kb-icon-choice svg { width: 18px; height: 18px; }
.kb-icon-choice.kb-on { border-color: var(--kb-accent); box-shadow: 0 0 0 1px var(--kb-accent); }
.kb-field-checks { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; margin-bottom: 6px; }
.kb-check { font-size: 13px; cursor: pointer; overflow-wrap: anywhere; }
.kb-textbtn {
	padding: 4px 10px;
	border: 1px solid var(--kb-border);
	border-radius: 8px;
	background: var(--kb-card-bg);
	color: var(--kb-fg);
	font: inherit;
	font-size: 13px;
	cursor: pointer;
}
.kb-textbtn:disabled { opacity: .5; cursor: default; }
.kb-textbtn.kb-danger { color: <<colour alert-highlight>>; }

.kb-board {
	position: relative;
	display: inline-block;
	min-width: 100%;
	padding: 4px 12px 12px;
	box-sizing: border-box;
}

.kb-grid {
	position: relative;
	display: grid;
	column-gap: 14px;
	row-gap: 0;
	align-items: stretch;
}

/* One tinted surface per column, from its header to the last swimlane. */
.kb-surface {
	position: relative;
	z-index: 0;
	border-radius: 16px;
	background: color-mix(in srgb, var(--kb-col) 15%, var(--kb-bg));
}
.kb-surface.kb-none {
	background: transparent;
	border: 2px dashed color-mix(in srgb, var(--kb-fg) 18%, transparent);
	box-sizing: border-box;
}

/* Swimlanes are only dashed lines across the board. */
.kb-lane-separator {
	position: relative;
	z-index: 2;
	height: 0;
	margin: 6px 0;
	border-top: 2px dashed color-mix(in srgb, var(--kb-fg) 28%, transparent);
	pointer-events: none;
}

.kb-edges {
	position: absolute;
	left: 0;
	top: 0;
	pointer-events: none;
	overflow: visible;
	z-index: 2;
}

.kb-edge-line {
	fill: none;
	stroke: var(--kb-muted);
	opacity: 0.85;
}

.kb-edge-head {
	fill: var(--kb-muted);
}

.kb-edge-hit {
	fill: none;
	stroke: transparent;
	stroke-width: 14px;
	pointer-events: stroke;
	cursor: pointer;
}

.kb-edge-clickable:hover .kb-edge-line,
.kb-edge.kb-selected .kb-edge-line {
	stroke: var(--kb-accent);
	opacity: 1;
}

.kb-edge-clickable:hover .kb-edge-head,
.kb-edge.kb-selected .kb-edge-head {
	fill: var(--kb-accent);
}

.kb-edge-delete {
	pointer-events: all;
	cursor: pointer;
}

.kb-edge-delete circle {
	fill: var(--kb-card-bg);
	stroke: var(--kb-accent);
	stroke-width: 1.5px;
}

.kb-edge-delete path {
	stroke: var(--kb-accent);
	stroke-width: 2px;
	stroke-linecap: round;
}

.kb-edge-delete:hover circle {
	fill: var(--kb-accent);
}

.kb-edge-delete:hover path {
	stroke: var(--kb-card-bg);
}

.kb-connect-line {
	fill: none;
	stroke: var(--kb-accent);
	stroke-width: 2px;
	stroke-dasharray: 6 4;
}

.kb-edge-label {
	font-size: 12px;
	fill: var(--kb-fg);
	paint-order: stroke;
	stroke: var(--kb-bg);
	stroke-width: 4px;
}

/* Headers */

.kb-header, .kb-corner {
	position: sticky;
	top: 0;
	z-index: 3;
}

.kb-header {
	display: flex;
	align-items: center;
	gap: 6px;
	padding: 2px 10px 1px;
	font-weight: 600;
	min-height: 20px;
}

.kb-header.kb-movable { cursor: grab; }
.kb-header-dragging { opacity: .45; }
.kb-move-marker {
	position: absolute;
	z-index: 5;
	background: var(--kb-accent);
	border-radius: 2px;
	pointer-events: none;
}
.kb-move-marker.kb-move-column { width: 4px; }
.kb-move-marker.kb-move-lane { height: 4px; }

.kb-column-header {
	justify-content: center;
	font-size: 1.05em;
	color: color-mix(in srgb, var(--kb-col) 82%, var(--kb-fg));
	fill: color-mix(in srgb, var(--kb-col) 82%, var(--kb-fg));
	background: color-mix(in srgb, var(--kb-col) 15%, var(--kb-bg));
	border-radius: 16px 16px 0 0;
}
.kb-column-header.kb-none {
	background: var(--kb-bg);
	color: var(--kb-muted);
	font-size: 1em;
}

.kb-header-icon { display: inline-flex; }
.kb-header-icon svg { width: 1.1em; height: 1.1em; }

.kb-corner {
	left: 0;
	z-index: 4;
	background: var(--kb-bg);
}

.kb-lane-header {
	position: sticky;
	left: 0;
	top: auto;
	z-index: 3;
	align-items: flex-start;
	max-width: 160px;
	padding: 8px 10px 8px 2px;
	background: var(--kb-bg);
}

.kb-header.kb-none .kb-header-label {
	font-style: italic;
	font-weight: normal;
	color: var(--kb-muted);
}

.kb-header-label {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.kb-lane-header .kb-header-label {
	white-space: normal;
}

.kb-header-count {
	font-weight: normal;
	font-size: 12px;
	color: var(--kb-muted);
	background: color-mix(in srgb, var(--kb-card-bg) 70%, transparent);
	border-radius: 10px;
	padding: 0 7px;
}

.kb-header-tools {
	display: flex;
	gap: 1px;
	opacity: 0;
	transition: opacity 0.15s;
}

.kb-header:hover .kb-header-tools,
.kb-header:focus-within .kb-header-tools {
	opacity: 1;
}

.kb-header-add {
	flex: none;
	width: 20px;
	height: 20px;
	border: none;
	border-radius: 50%;
	background: var(--kb-col);
	color: #fff;
	font-size: 15px;
	line-height: 20px;
	padding: 0;
	cursor: pointer;
	opacity: .85;
}
.kb-header-add:hover { opacity: 1; }
.kb-column-header .kb-header-tools { position: absolute; right: 6px; top: 1px; }

.kb-tool, .kb-card-remove {
	border: none;
	background: transparent;
	color: var(--kb-muted);
	cursor: pointer;
	padding: 0 4px;
	font-size: 14px;
	line-height: 20px;
	border-radius: 4px;
}

.kb-iconbtn svg, .kb-tool svg {
	width: 16px;
	height: 16px;
	fill: currentColor;
	vertical-align: middle;
}
.kb-tool svg { width: 13px; height: 13px; }

.kb-tool:hover, .kb-card-remove:hover {
	color: var(--kb-fg);
	background: var(--kb-cell-bg);
}

.kb-adder {
	border: 1px dashed var(--kb-border);
	background: transparent;
	color: var(--kb-muted);
	border-radius: 6px;
	padding: 6px 8px;
	text-align: left;
	cursor: pointer;
	position: sticky;
	top: 0;
	z-index: 3;
}

.kb-lane-adder {
	position: sticky;
	left: 0;
	top: auto;
	max-width: 180px;
}

.kb-adder:hover {
	color: var(--kb-fg);
	border-color: var(--kb-accent);
}

.kb-editor {
	position: sticky;
	top: 0;
	z-index: 3;
}

.kb-lane-editor {
	left: 0;
	top: auto;
}

.kb-input {
	width: 100%;
	box-sizing: border-box;
	padding: 5px 7px;
	border: 1px solid var(--kb-accent);
	border-radius: 6px;
	font: inherit;
	color: var(--kb-fg);
	background: var(--kb-card-bg);
}

/* Cells and cards */

.kb-cell {
	position: relative;
	z-index: 1;
	display: flex;
	flex-direction: column;
	gap: 8px;
	padding: 6px 10px;
	min-height: 44px;
}

.kb-filler {
	min-height: 0;
}

.kb-card {
	position: relative;
	background: var(--kb-card-bg);
	border: 1px solid color-mix(in srgb, var(--kb-border) 70%, transparent);
	border-left: 4px solid var(--kb-card-color, var(--kb-border));
	border-radius: 8px;
	padding: 8px 10px;
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 4px 12px rgba(0, 0, 0, 0.05);
	cursor: grab;
	touch-action: none;
	-webkit-user-select: none;
	user-select: none;
	overflow: hidden;
	overflow-wrap: anywhere;
}

.kb-readonly .kb-card {
	cursor: pointer;
	touch-action: auto;
}

.kb-card:focus-visible {
	outline: 2px solid var(--kb-accent);
	outline-offset: 1px;
}

.kb-card.kb-hidden {
	display: none;
}

.kb-card-title {
	display: flex;
	align-items: flex-start;
	gap: 4px;
	font-weight: 600;
	padding-right: 16px;
}
.kb-card-label { flex: 1; min-width: 0; }
.kb-card-toggle {
	flex: none;
	border: none;
	background: transparent;
	color: var(--kb-muted);
	cursor: pointer;
	padding: 0 4px;
	font-size: 14px;
	line-height: 20px;
	border-radius: 4px;
}
.kb-card-toggle:hover { background: var(--kb-header-bg); color: var(--kb-fg); }
.kb-card-collapsible .kb-card-title { padding-right: 18px; }
.kb-card-open.kb-card-collapsible .kb-card-toggle { color: var(--kb-accent); }
.kb-card-compact { padding: 4px 8px; }
.kb-card-compact .kb-card-label {
	font-weight: 500;
	font-size: 13px;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.kb-card-body {
	font-size: 13px;
	-webkit-user-select: text;
	user-select: text;
}

.kb-card-title + .kb-card-body {
	margin-top: 4px;
}

.kb-card-body > p:first-child, .kb-field p:first-child {
	margin-top: 0;
}

.kb-card-body p:last-child {
	margin-bottom: 0;
}

.kb-card-body img {
	max-width: 100%;
	height: auto;
}

.kb-field + .kb-field {
	margin-top: 3px;
}

.kb-field-name {
	color: var(--kb-muted);
	margin-right: 6px;
}

.kb-card-remove {
	position: absolute;
	top: 2px;
	right: 2px;
	opacity: 0;
}

.kb-card:hover .kb-card-remove {
	opacity: 1;
}

.kb-card-connector {
	position: absolute;
	right: 3px;
	bottom: 3px;
	width: 12px;
	height: 12px;
	border-radius: 50%;
	background: var(--kb-accent);
	border: 2px solid var(--kb-card-bg);
	box-sizing: border-box;
	cursor: crosshair;
	opacity: 0;
}

.kb-card:hover .kb-card-connector,
.kb-card.kb-connect-source .kb-card-connector {
	opacity: 1;
}

.kb-is-dragging .kb-card-connector,
.kb-readonly .kb-card-connector {
	display: none;
}

.kb-card.kb-connect-target {
	outline: 2px solid var(--kb-accent);
	outline-offset: 1px;
}

.kb-is-connecting .kb-card {
	cursor: crosshair;
}

.kb-add-card {
	border: none;
	background: transparent;
	color: var(--kb-muted);
	font-size: 16px;
	border-radius: 6px;
	padding: 2px;
	cursor: pointer;
	opacity: 0;
	transition: opacity 0.15s;
	margin-top: auto;
}

.kb-cell:hover .kb-add-card, .kb-add-card:focus-visible {
	opacity: 1;
}

/* In an empty cell, show where a card can be added. */
.kb-cell:not(:has(.kb-card)) .kb-add-card {
	opacity: .45;
	border: 1px dashed color-mix(in srgb, var(--kb-fg) 18%, transparent);
}
.kb-cell:not(:has(.kb-card)):hover .kb-add-card { opacity: 1; }

.kb-add-card:hover {
	background: color-mix(in srgb, var(--kb-card-bg) 60%, transparent);
	color: var(--kb-fg);
}

.kb-placeholder {
	border: 2px dashed var(--kb-accent);
	border-radius: 6px;
	box-sizing: border-box;
	opacity: 0.6;
}

.kb-ghost {
	position: fixed;
	left: 0;
	top: 0;
	z-index: 10000;
	pointer-events: none;
	box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
	cursor: grabbing;
	background: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	border-color: <<colour tiddler-border>>;
	font-size: 14px;
}

.kb-is-dragging, .kb-is-dragging * {
	cursor: grabbing !important;
}

.kb-is-dragging .kb-add-card {
	opacity: 0;
}

.kb-card.kb-flash {
	animation: kb-flash 1.2s ease-out;
}

@keyframes kb-flash {
	0% { box-shadow: 0 0 0 4px var(--kb-accent); }
	100% { box-shadow: 0 0 0 0 transparent; }
}

/*** Card viewer ***/

.kb-modal {
	position: fixed;
	inset: 0;
	z-index: 10001;
	height: 100vh;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(10, 10, 14, .55);
	backdrop-filter: blur(4px);
	-webkit-backdrop-filter: blur(4px);
	animation: kb-fade .15s ease;
}

@keyframes kb-fade { from { opacity: 0; } to { opacity: 1; } }

.kb-modal-sheet {
	position: relative;
	box-sizing: border-box;
	width: min(960px, 100vw);
	/* As tall as the tiddler needs, up to the whole screen. */
	max-height: 100vh;
	overflow-y: auto;
	border-radius: 14px;
	background: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	box-shadow: 0 0 60px rgba(0,0,0,.35);
	padding: 56px clamp(18px, 6vw, 72px) 44px;
	outline: none;
}
.kb-modal-editing .kb-modal-sheet { height: 100vh; }
@media (max-width: 960px), (max-height: 600px) {
	.kb-modal-sheet { border-radius: 0; }
}

.kb-modal-controls {
	position: sticky;
	top: -40px;
	float: right;
	margin: -40px calc(-1 * clamp(10px, 4vw, 56px)) 0 0;
	display: flex;
	gap: 6px;
	z-index: 2;
	opacity: 0;
	transition: opacity .15s ease;
}

.kb-modal-sheet:hover .kb-modal-controls,
.kb-modal-controls:focus-within,
.kb-modal-editing .kb-modal-controls { opacity: 1; }

@media (hover: none) {
	.kb-modal-controls { opacity: 1; }
}

.kb-modal-btn {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	height: 36px;
	padding: 0 12px;
	border: 1px solid <<colour tiddler-border>>;
	border-radius: 18px;
	background: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	box-shadow: 0 2px 10px rgba(0,0,0,.12);
	cursor: pointer;
	font-size: 14px;
}
.kb-modal-btn:hover { border-color: <<colour primary>>; color: <<colour primary>>; }
.kb-modal-btn .kb-icon { width: 17px; height: 17px; }

.kb-modal-header { margin-bottom: 1em; }
.kb-modal-icon { display: inline-block; vertical-align: middle; margin-right: .4em; }
.kb-modal-icon svg, .kb-modal-icon img { width: 1.6em; height: 1.6em; }
.kb-modal-title { display: inline; margin: 0; font-size: 2.2em; line-height: 1.2; overflow-wrap: anywhere; }
.kb-modal-subtitle { color: <<colour muted-foreground>>; margin-top: .3em; }
.kb-modal-body { font-size: 1.1em; line-height: 1.6; }
.kb-modal-body img { max-width: 100%; height: auto; }
.kb-modal-missing { color: <<colour muted-foreground>>; font-style: italic; }

.kb-modal-edit {
	display: flex;
	flex-direction: column;
	gap: 10px;
	height: calc(100% - 4em);
}

.kb-modal-editor {
	width: 100%;
	min-height: 60vh;
	flex: 1;
	box-sizing: border-box;
	font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	font-size: 15px;
	line-height: 1.5;
	padding: 12px;
	border: 1px solid <<colour tiddler-border>>;
	border-radius: 8px;
	resize: vertical;
}

@media (prefers-reduced-motion: reduce) {
	.kb-modal { animation: none; }
}

/* The card's fields, editable in place. */
.kb-modal-fields {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
	gap: 8px 14px;
	margin: 0 0 1.2em;
	padding: 12px 14px;
	border-radius: 10px;
	background: color-mix(in srgb, <<colour foreground>> 4%, transparent);
	font-size: 14px;
}
.kb-modal-field { display: flex; flex-direction: column; gap: 3px; cursor: default; }
.kb-modal-field-name { font-size: 11px; font-weight: 600; letter-spacing: .02em; color: <<colour muted-foreground>>; }
.kb-modal-input {
	width: 100%;
	box-sizing: border-box;
	padding: 5px 8px;
	border: 1px solid transparent;
	border-radius: 6px;
	background: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	font: inherit;
}
.kb-modal-input:hover { border-color: <<colour tiddler-border>>; }
.kb-modal-input:focus { border-color: <<colour primary>>; outline: none; }
.kb-modal-input:disabled { opacity: .7; }
.kb-modal-input.kb-modal-column {
	border-left: 4px solid var(--kb-col);
	font-weight: 600;
}
